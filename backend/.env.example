APP_ENV=development
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./app.db

# LLM Provider Configuration (OpenAI compatible)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
MODELS_CACHE_TTL_SECONDS=300
USE_MOCK_AI_FALLBACK=true
TRANSCRIPTION_MODEL=whisper-1

# Optional Langfuse observability (disabled until credentials are provided)
USE_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_SAMPLE_RATE=1.0

# NewsAPI data source for news and RSS-style trigger nodes
# Create/rotate the key at https://newsapi.org and never commit it.
NEWS_API_KEY=
NEWS_API_BASE_URL=https://newsapi.org/v2
NEWS_API_TIMEOUT_SECONDS=15
NEWS_API_PAGE_SIZE=10
